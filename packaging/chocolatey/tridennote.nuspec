<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>tridennote</id>
    <version>__VERSION__</version>
    <title>tridennote</title>
    <authors>Harith Iqbal</authors>
    <owners>hrithiqball</owners>
    <projectUrl>https://github.com/hrithiqball/tridennote-tui</projectUrl>
    <projectSourceUrl>https://github.com/hrithiqball/tridennote-tui</projectSourceUrl>
    <bugTrackerUrl>https://github.com/hrithiqball/tridennote-tui/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/hrithiqball/tridennote-tui/releases/tag/v__VERSION__</releaseNotes>
    <licenseUrl>https://github.com/hrithiqball/tridennote-tui/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>notes markdown tui terminal cli kanban</tags>
    <summary>Notes, next level, in your terminal.</summary>
    <description>Tridennote in your terminal: browse your vault in a Neovim-style tree, read notes as rendered markdown (Mermaid diagrams included), run kanban boards, and edit them in the built-in editor or your own.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
